{
  "version": 1,
  "catalogue_id": "autopilot-testapps-v1",
  "created_at": "2026-10-23",
  "description": "Fixed test-application catalogue for SPEC-30. The graph is a SPEC-06 R-11 snapshot; the deployed GET /deployments/{id}/graph remains authoritative.",
  "apps": [
    {
      "app_id": "storefront",
      "version": "1.0.0",
      "description": "Three-service storefront: static frontend, Node backend API, Postgres database.",
      "services": [
        {
          "name": "frontend",
          "type": "static",
          "port": 3000,
          "load_paths": ["/"]
        },
        {
          "name": "backend",
          "type": "node",
          "port": 8000,
          "load_paths": ["/api"]
        },
        {
          "name": "database",
          "type": "stateful",
          "port": 5432,
          "load_paths": []
        }
      ],
      "graph": {
        "nodes": [
          {"id": "frontend", "type": "static", "port": 3000},
          {"id": "backend", "type": "node", "port": 8000},
          {"id": "database", "type": "stateful", "port": 5432}
        ],
        "edges": [
          {"from": "frontend", "to": "backend", "kind": "route"},
          {"from": "backend", "to": "database", "kind": "dependsOn"}
        ]
      },
      "observability": {
        "prometheus": true,
        "traces": true,
        "logs": true,
        "app_side_config": false
      },
      "load": {
        "host": "http://frontend:3000",
        "endpoints": [
          {"path": "/", "weight": 3, "service": "frontend"},
          {"path": "/api", "weight": 2, "service": "backend"}
        ]
      },
      "fault_hooks": {
        "F7": "/__autopilot/faults/F7",
        "F8": "/__autopilot/faults/F8",
        "F9": "/__autopilot/faults/F9",
        "F10": "/__autopilot/faults/F10"
      }
    }
  ]
}
