# ---------------------------------------------------------------
# AutoPilot dev environment - copy to .env (gitignored).
# Real .env is never committed. Dev-only passwords; deployments
# must generate their own secrets and must not reuse these values.
# ---------------------------------------------------------------

# --- processes (control API) - app + audit roles only (SPEC-03 R-2) ---
# The app process NEVER holds the migrator DSN: no BYPASSRLS credential
# ever reaches request traffic.
APP_DATABASE_URL=postgresql://autopilot_app:devonly-change-me@localhost:5432/autopilot_platform
AUDIT_DATABASE_URL=postgresql://autopilot_audit:devonly-change-me@localhost:5432/autopilot_audit
REDIS_URL=redis://localhost:6379/0
APP_ENV_NAME=dev
SECRET_KEY_BASE=devonly-change-me

# --- migrations (migrations/apply.py) - the migrator role ---
DATABASE_URL=postgresql://autopilot_migrator:devonly-change-me@localhost:5432/autopilot_platform

# --- local-only developer login (never enable in production) ---
# The route is refused unless APP_ENV_NAME=dev, and must stay disabled
# in every deployment. COOKIE_SECURE=false is only for local HTTP.
DEV_LOGIN_ENABLED=true
COOKIE_SECURE=false

# --- secrets envelope (SPEC-18) ---
# 32-byte key outside git. Generate with:
#   uv run python -c "import secrets, pathlib; p=pathlib.Path('.local/master.key'); p.parent.mkdir(exist_ok=True); p.write_bytes(secrets.token_bytes(32))"
MASTER_KEY_FILE=.local/master.key

# --- console + application routing ---
CONSOLE_BASE_URL=http://localhost:5173
APPS_DOMAIN=apps.localtest.me

# --- pytest schema contract tests (tests/contract/) ---
# Same three values as above, exported in the shell:
#   $env:DATABASE_URL = ...      (PowerShell)   |   export DATABASE_URL=...   (bash)
#   $env:APP_DATABASE_URL = ...
#   $env:AUDIT_DATABASE_URL = ...
